{
  "info": {
    "name": "Movie Library API Training",
    "_postman_id": "4ee51521-b7cf-4f72-a423-78f0d30d4051",
    "description": "REST API training collection for the Movie Library app. Run requests in order: create a workspace, list movies, create/update/delete a movie, then verify 404.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "workspaceId", "value": "", "type": "string" },
    { "key": "movieId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "Create workspace and save ID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Training Workspace\"\n}"
            },
            "url": "{{baseUrl}}/api/workspaces"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('workspace creation returns 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('workspace has a valid ID', function () { pm.expect(body.workspace.id).to.match(/^[0-9a-f-]{36}$/i); });",
                  "pm.test('workspace is seeded', function () { pm.expect(body.moviesSeeded).to.eql(10); });",
                  "pm.collectionVariables.set('workspaceId', body.workspace.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get workspace",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('workspace retrieval returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('workspace id matches variable', function () { pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('workspaceId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset workspace",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/workspaces/{{workspaceId}}/reset"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('workspace reset returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('reset restores 10 movies', function () { pm.expect(pm.response.json().seeded).to.eql(10); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List movies",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "{{workspaceId}}" }],
            "url": "{{baseUrl}}/api/movies?page=1&limit=10&sortBy=createdAt&order=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('response has pagination metadata', function () { const body = pm.response.json(); pm.expect(body.pagination).to.have.keys(['page', 'limit', 'total', 'totalPages']); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create movie and save ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Movie\",\n  \"director\": \"QA Learner\",\n  \"year\": 2024,\n  \"genre\": \"Drama\",\n  \"rating\": 7.4,\n  \"watched\": false,\n  \"description\": \"Created from the Postman collection.\"\n}"
            },
            "url": "{{baseUrl}}/api/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('movie creation returns 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('created movie has a valid ID', function () { pm.expect(body.data.id).to.match(/^[0-9a-f-]{36}$/i); });",
                  "pm.test('location header is present', function () { pm.expect(pm.response.headers.get('Location')).to.include('/api/movies/'); });",
                  "pm.collectionVariables.set('movieId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created movie",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "{{workspaceId}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created movie retrieval returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('retrieved movie id matches saved id', function () { pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('movieId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT replace movie",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Movie Replaced\",\n  \"director\": \"QA Learner\",\n  \"year\": 2024,\n  \"genre\": \"Comedy\",\n  \"rating\": 8.1\n}"
            },
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PUT returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('PUT applies replacement defaults', function () { const body = pm.response.json(); pm.expect(body.data.genre).to.eql('Comedy'); pm.expect(body.data.watched).to.eql(false); pm.expect(body.data.description).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH movie watched",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "{{workspaceId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"watched\": true\n}" },
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('PATCH returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('PATCH modifies specified property', function () { pm.expect(pm.response.json().data.watched).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter sorted movies",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "{{workspaceId}}" }],
            "url": "{{baseUrl}}/api/movies?genre=Drama&watched=false&sortBy=rating&order=desc&page=1&limit=5"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('filtered list returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('limit is honored', function () { pm.expect(pm.response.json().pagination.limit).to.eql(5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "X-Workspace-ID", "value": "{{workspaceId}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('DELETE returns 204', function () { pm.response.to.have.status(204); });",
                  "pm.test('DELETE has no response body', function () { pm.expect(pm.response.text()).to.eql(''); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted movie returns 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Workspace-ID", "value": "{{workspaceId}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deleted movie returns 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('error response has code and message', function () { const error = pm.response.json().error; pm.expect(error.code).to.eql('NOT_FOUND'); pm.expect(error.message).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative: invalid movie body",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Workspace-ID", "value": "{{workspaceId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A\",\n  \"director\": 123,\n  \"year\": 1800,\n  \"genre\": \"Musical\",\n  \"rating\": 11\n}"
            },
            "url": "{{baseUrl}}/api/movies"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid body returns 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('validation details are present', function () { pm.expect(pm.response.json().error.details.length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
