# PostgreSQL connection string. Use a Neon pooled connection string for Vercel runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct Neon connection string used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional deployment origin used in OpenAPI examples. Leave blank locally.
NEXT_PUBLIC_APP_URL=""

# Rate limit knobs for public write endpoints.
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="30"
